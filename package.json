{
  "name": "m4",
  "version": "0.1.0",
  "private": true,
  "description": "M4 \u2014 Multi Model, Multi Modal.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @m4/web dev",
    "build": "pnpm --filter @m4/web build",
    "start": "pnpm --filter @m4/web start",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @m4/web test:e2e",
    "operator:create": "pnpm --filter @m4/web operator:create",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && pnpm db:generate",
    "db:push": "prisma db push && pnpm db:generate",
    "db:studio": "prisma studio",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:reset": "docker compose -f docker/docker-compose.yml down -v && pnpm db:up",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:deploy": "prisma migrate deploy"
  },
  "devDependencies": {
    "@m4/config": "workspace:*",
    "dotenv": "^16.4.7",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.28"
    }
  }
}
