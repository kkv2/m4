// M4 — multi-tenant schema.
//
// Every row that carries knowledge or conversation belongs to exactly one
// Tenant. There is no per-user private space by design: uploaded files and the
// knowledge derived from them are shared across the whole tenant.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/client"
  // Emit explicit extensions so the client resolves under plain Node ESM too,
  // not only through a bundler.
  importFileExtension = "ts"
}

// The connection URL lives in prisma.config.ts at the workspace root, and the
// runtime connection comes from the driver adapter in src/index.ts.
datasource db {
  provider = "postgresql"
}

/// The languages M4 speaks. Exactly two, by design.
enum Language {
  JA
  EN
}

/// Which sign-in screen an attempt came from. Operator and tenant counters
/// never share a key.
enum SignInSurface {
  OPERATOR
  TENANT
}

/// What a throttle row counts: one account, or one calling client.
enum ThrottleScope {
  ACCOUNT
  CLIENT
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum LlmProvider {
  OPENAI
  GEMINI
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Tenant {
  id              String   @id @default(cuid())
  /// Display name, as the operator entered it. Not unique: two customers may
  /// legitimately share a name, and `id` is what tells them apart.
  name            String
  /// Pre-selected for every user registered under this tenant.
  defaultLanguage Language @default(JA) @map("default_language")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  users         User[]
  conversations Conversation[]
  documents     Document[]

  @@map("tenants")
}

model User {
  id           String @id @default(cuid())
  tenantId     String @map("tenant_id")
  /// Unique across the whole platform, not merely within the tenant: sign-in
  /// takes an address and a password and nothing else, so the address alone has
  /// to identify both the account and its tenant. Immutable after registration.
  email        String @unique
  name         String
  passwordHash String @map("password_hash")

  /// Set from the tenant default at registration, then owned by the user.
  language              Language
  /// When the user passed the first-login language step. Null means they have
  /// not — which is not the same as `language` having no value.
  languageConfirmedAt   DateTime? @map("language_confirmed_at")
  /// True whenever the current password was generated rather than chosen.
  mustChangePassword    Boolean   @default(true) @map("must_change_password")
  /// Set only once both first-login steps are done. Read by the operator console.
  firstLoginCompletedAt DateTime? @map("first_login_completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  documents     Document[]
  sessions      UserSession[]

  @@index([tenantId])
  @@map("users")
}

/// A member of SaaS operations staff. Belongs to no tenant, which is what lets
/// the type system keep operators and tenant users apart. Created only by the
/// bootstrap CLI — there is no screen or endpoint that makes one.
model Operator {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions OperatorSession[]

  @@map("operators")
}

/// A signed-in tenant user. Separate from OperatorSession on purpose: two
/// tables make crossing the operator/user boundary unrepresentable rather than
/// merely checked.
model UserSession {
  id         String   @id @default(cuid())
  /// SHA-256 of the opaque token the browser holds. The token itself is never
  /// stored, so a database dump cannot be replayed as a session.
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  expiresAt  DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// A signed-in operator. Same shape as UserSession, against Operator.
model OperatorSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash")
  operatorId String   @map("operator_id")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  expiresAt  DateTime @map("expires_at")

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([operatorId])
  @@index([expiresAt])
  @@map("operator_sessions")
}

/// One counter per (surface, scope, key). The ACCOUNT key is the submitted
/// email address rather than a user id, so the counter behaves identically for
/// an address that has no account — which is what stops throttling from
/// leaking whether an address is registered.
model SignInThrottle {
  id              String        @id @default(cuid())
  surface         SignInSurface
  scope           ThrottleScope
  key             String
  failureCount    Int           @default(0) @map("failure_count")
  windowStartedAt DateTime      @default(now()) @map("window_started_at")

  @@unique([surface, scope, key])
  @@index([windowStartedAt])
  @@map("sign_in_throttles")
}

model Conversation {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([tenantId, updatedAt])
  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  role           MessageRole
  /// Rendered text content. Non-text modalities live in `attachments`.
  content        String
  /// The model that produced this message, e.g. "gpt-4o" or "gemini-2.0-flash".
  provider       LlmProvider?
  model          String?
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  Attachment[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Attachment {
  id         String   @id @default(cuid())
  messageId  String   @map("message_id")
  /// Object storage key. Local development writes to the Docker volume.
  storageKey String   @map("storage_key")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("attachments")
}

model Document {
  id           String         @id @default(cuid())
  tenantId     String         @map("tenant_id")
  uploadedById String?        @map("uploaded_by_id")
  title        String
  storageKey   String         @map("storage_key")
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  status       DocumentStatus @default(PENDING)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  chunks     DocumentChunk[]

  @@index([tenantId, createdAt])
  @@map("documents")
}

/// One retrievable unit of a Document. The embedding column is added by a
/// follow-up migration once the pgvector extension is enabled.
model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  /// Position of this chunk within its source document, starting at 0.
  ordinal    Int
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([documentId])
  @@map("document_chunks")
}
